generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Single business workspace. In practice most installs have one row, but the
/// schema allows several (e.g. an agency running the tool for multiple clients).
model BusinessProfile {
  id                 String   @id @default(cuid())
  businessName       String
  industry           String
  productsServices   String
  targetAudience     String
  brandVoice         String // one of the preset voice ids, or "custom"
  customVoiceName    String?
  customVoiceNotes   String?
  voiceSamples       String? // JSON string[] of example writing the user provided
  location           String?
  website            String?
  socialAccounts     String? // JSON { platform: handle }
  brandDescription   String?
  usp                String?
  pricingInfo        String?
  currentPromotions  String?
  goals              String? // JSON string[]
  competitors        String? // JSON string[]
  preferredPlatforms String? // JSON string[]
  contentPillars     String? // JSON ContentPillar[] cached from last generation
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contentItems  ContentItem[]
  calendars     ContentCalendar[]
  campaigns     Campaign[]
  leadMagnets   LeadMagnet[]
  conversations Conversation[]
}

/// Singleton row holding app-wide settings (which business profile is active).
model Settings {
  id                      String  @id @default("singleton")
  activeBusinessProfileId String?
}

/// One saved piece of content in the Content Library. `body` holds the
/// structured generation result as JSON so the UI can re-render it richly.
model ContentItem {
  id                String           @id @default(cuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  type            String // social_post | video_script | email | blog_post | sales_copy | lead_magnet | campaign_asset | improved_content | idea | image_prompt | other
  platform        String? // facebook | instagram | tiktok | linkedin | youtube | email | blog | general
  title           String
  body            String // JSON-serialized structured content
  imagePrompt     String?
  qualityScore    Int?
  qualityFeedback String? // JSON QualityReport
  tags            String? // JSON string[]
  pillar          String?
  favorite        Boolean  @default(false)
  sourceTool      String? // which tool produced this (social, video, calendar, campaign, repurpose, improver, sales, lead-magnet, assistant...)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContentCalendar {
  id                String           @id @default(cuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  title     String
  days      Int
  startDate DateTime
  entries   String // JSON CalendarEntry[]
  createdAt DateTime @default(now())
}

model Campaign {
  id                String           @id @default(cuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  title     String
  input     String // JSON of the campaign brief inputs
  strategy  String // JSON structured campaign output
  createdAt DateTime @default(now())
}

model LeadMagnet {
  id                String           @id @default(cuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  format    String // ebook | checklist | guide | workbook | resource_list | template | quiz | free_report | cheat_sheet
  title     String
  content   String // JSON structured lead magnet output
  createdAt DateTime @default(now())
}

model Conversation {
  id                String           @id @default(cuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
}

// ============================================================================
// AI Character Generation Platform
//
// A separate feature area in the same app/database. A `Character` is the
// durable identity record — everything a future generation needs to bring
// that character back is stored here or on its related rows, never just a
// cached text prompt. See CHARACTERS.md for the full design rationale.
// ============================================================================

/// The character's identity record: structured profile + the canonical
/// appearance description reused verbatim in every future generation, plus
/// the provider-specific identity-lock state (reference images and/or a
/// trained LoRA).
model Character {
  id   String @id @default(cuid())
  name String

  style      String // realistic | semi_realistic | cartoon | anime | 3d_animated | other
  species    String  @default("human") // human | animal | fantasy | robot | other
  age        String?
  gender     String?
  occupation String?

  personalityTraits String // JSON string[]
  personalitySummary String? // 2-4 sentence prose summary
  background         String? // backstory / bio
  voiceDescription   String? // descriptive notes on how the character sounds (tone, pace, accent)
  voiceProviderId    String? // future: a TTS provider's voice id once assigned

  // The identity anchor. `physicalDescription` is the single canonical
  // appearance paragraph (face, skin tone, hair, body type, distinguishing
  // marks) that is injected UNCHANGED into every prompt for this character —
  // this is what keeps "memory" real instead of being re-guessed each time.
  physicalDescription String
  faceDescriptor       String? // tighter face-only description, used to weight identity-lock prompts
  defaultOutfitDescription String?

  seed               Int? // base seed, reused as one (minor) consistency signal
  negativePrompt     String? // persistent negative prompt (things that must never appear)

  identityLockMode String  @default("reference_image") // reference_image | lora | seed_only
  loraModelId      String? // set once a per-character LoRA has finished training
  loraStatus       String  @default("none") // none | training | ready | failed
  loraTrainingId   String? // provider-side training job id, for polling

  sourceDescription String // the original free-text description the user typed, kept for provenance only — never used as a substitute for the structured fields above

  referenceImages    CharacterReferenceImage[]
  outfits            CharacterOutfit[]
  generations        GenerationCharacter[]
  relationshipsFrom  CharacterRelationship[]  @relation("CharacterFrom")
  relationshipsTo    CharacterRelationship[]  @relation("CharacterTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Visual reference material for a character — the real identity anchor.
/// Either generated once as a "character sheet" or uploaded by the user.
model CharacterReferenceImage {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  url       String
  kind      String // generated_sheet | user_upload
  angle     String? // front | three_quarter | side | closeup | full_body
  isPrimary Boolean @default(false) // the canonical face reference used for identity-lock conditioning

  createdAt DateTime @default(now())
}

/// A named outfit a character can be generated in, independent of identity.
model CharacterOutfit {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name        String
  description String
  imageUrl    String?

  createdAt DateTime @default(now())
}

/// A directed relationship between two characters (e.g. Marcus -> Tina:
/// "customer"). Stored once per direction so the description can be
/// asymmetric ("Tina's mechanic" vs. "Marcus's regular customer").
model CharacterRelationship {
  id String @id @default(cuid())

  fromCharacterId String
  fromCharacter   Character @relation("CharacterFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacterId   String
  toCharacter     Character @relation("CharacterTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  relationshipType String // e.g. coworker, family, rival, friend, comedy-duo
  description      String?

  createdAt DateTime @default(now())

  @@unique([fromCharacterId, toCharacterId])
}

/// One generated image (character sheet or scene). Keeps the exact compiled
/// prompt and provider/model used so results are reproducible and auditable.
model Generation {
  id   String @id @default(cuid())
  type String // character_sheet | scene

  prompt         String
  negativePrompt String?
  provider       String // e.g. replicate
  model          String // underlying model id used
  sceneParams    String? // JSON: pose, expression, environment, cameraAngle, lighting, outfitId

  status       String  @default("pending") // pending | completed | failed
  imageUrl     String?
  errorMessage String?

  characters GenerationCharacter[]

  createdAt DateTime @default(now())
}

/// Join table: which characters appear in a given generation.
model GenerationCharacter {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  characterId  String
  character    Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  outfitId     String? // which of that character's outfits was used, if any

  @@unique([generationId, characterId])
}
