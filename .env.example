# Required: an Anthropic API key (or omit and use `ant auth login` instead).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for all generation. Defaults to
# Anthropic's most capable widely released model if unset.
# ANTHROPIC_MODEL=claude-opus-5

# SQLite database file used by Prisma. The default works out of the box.
DATABASE_URL="file:./dev.db"

# --- AI Character Generation Platform -------------------------------------
# Required for character reference images and scene generation.
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: which image provider to use (currently only "replicate" ships).
# IMAGE_PROVIDER=replicate

# Optional: override the underlying Replicate models.
# REPLICATE_TEXT2IMG_MODEL=black-forest-labs/flux-dev
# REPLICATE_FACE_MODEL=zsxkib/instant-id
# REPLICATE_LORA_TRAINER=ostris/flux-dev-lora-trainer

# Optional: only needed if you use the (advanced, opt-in) per-character LoRA
# training path — a destination model slug (owner/model-name) you created
# in your Replicate account to receive the trained weights.
# REPLICATE_LORA_DESTINATION=
