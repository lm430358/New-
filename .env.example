# Required for every AI feature (lead scoring, outreach personalization, the
# AI Consultant report generator): an Anthropic API key, or omit and use
# `ant auth login` instead.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for all generation.
# ANTHROPIC_MODEL=claude-opus-5

# SQLite database file used by Prisma. The default works out of the box.
DATABASE_URL="file:./dev.db"
