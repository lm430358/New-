# Required: an Anthropic API key (or omit and use `ant auth login` instead).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for all AI features. Defaults to
# Anthropic's most capable widely released model if unset.
# ANTHROPIC_MODEL=claude-opus-5

# SQLite database file used by Prisma. The default works out of the box.
DATABASE_URL="file:./dev.db"

# Optional: NHTSA vPIC VIN decoding is free/keyless and used by default
# (https://vpic.nhtsa.dot.gov/api/). No key required for VIN lookup.
