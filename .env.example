# Required: an Anthropic API key (or omit and use `ant auth login` instead).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for all generation. Defaults to
# Anthropic's most capable widely released model if unset.
# ANTHROPIC_MODEL=claude-opus-5

# SQLite database file used by Prisma. The default works out of the box.
DATABASE_URL="file:./dev.db"

# ── Trading assistant (see README "Trading Assistant") ──
# Alpaca PAPER keys (fake money): https://app.alpaca.markets → Paper account → API keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Live trading stays locked unless this is exactly "true". Leave it off during the paper week.
# ALPACA_LIVE_ENABLED=false

# Twilio for YES/NO texts: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # your Twilio number, e.g. +15551234567
OWNER_PHONE_NUMBER=      # your cell, e.g. +15557654321 — only this number can approve trades

# Public base URL of this app (used in approval links and Twilio signature checks)
PUBLIC_BASE_URL=http://localhost:3000

# Password for the /trading dashboard (username: anything). Strongly recommended if deployed.
TRADING_ADMIN_PASSWORD=
# Secret for an external scheduler to call POST /api/trading/scan (header: Authorization: Bearer <secret>)
TRADING_CRON_SECRET=
# Run the scanner inside the server every N minutes (0 = off; use an external cron instead)
TRADING_AUTOSCAN_MINUTES=0
